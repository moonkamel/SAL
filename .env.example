# Copier ce fichier en .env.local et remplir les valeurs.
# Les variables SANS préfixe EXPO_PUBLIC_ restent côté serveur (routes API)
# et ne sont jamais incluses dans l'application.

# --- Serveur ---
# Clé Google restreinte à « Places API (New) » (et « Routes API » à l'étape 3).
GOOGLE_PLACES_API_KEY=

# Optionnel : reformulation des requêtes libres par Claude.
# Sans clé, la requête est envoyée telle quelle à Google Places.
ANTHROPIC_API_KEY=
# Mettre à false pour couper la reformulation même si une clé est présente.
ENABLE_LLM_REWRITE=true
# Modèle utilisé pour la reformulation (voir README).
ANTHROPIC_MODEL=claude-opus-5

# Durée du cache des recherches identiques, en secondes.
SEARCH_CACHE_TTL_SECONDS=300

# Données ouvertes lilloises (valeurs par défaut suffisantes).
# Clé de l'open data MEL, si l'API des prochains passages Ilévia l'exige.
MEL_API_KEY=
# VLILLE_GBFS_URL=https://media.ilevia.fr/opendata/gbfs.json
# Météo (Open-Meteo, sans clé).
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Espace partenaires (/admin) : mot de passe de 12 caractères minimum.
ADMIN_PASSWORD=
# Base Supabase de l'espace partenaires (voir README). Clé service_role : secrète,
# jamais préfixée par EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Agenda OpenAgenda (optionnel) : clé API et identifiants d'agendas séparés par des virgules.
OPENAGENDA_KEY=
OPENAGENDA_AGENDAS=

# --- Application ---
# Clés Maps / Navigation SDK embarquées dans l'app (étape 2+), une par plateforme,
# restreintes au package Android / bundle ID iOS. Pour les builds EAS, les définir
# aussi dans les variables d'environnement EAS (voir README).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# URL publique du backend en production (ex. https://sortir-a-lille.expo.app).
# Laisser vide en développement : l'app interroge le serveur Metro.
EXPO_PUBLIC_API_URL=
